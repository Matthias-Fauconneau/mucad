%YAML 1.2
---
# See http://sublimetext.com
name: mucad
file_extensions:
  - mu
scope: source.mucad

contexts:
  main:
    - include: comments
    - include: strings
    - include: keywords
    - include: types
    - include: numbers_and_units
    - include: functions_and_workbenches
    - include: operators
    - include: punctuation

  comments:
    - match: //.*$
      scope: comment.line.double-slash.mucad
    - match: /\*
      scope: punctuation.definition.comment.begin.mucad
      push:
        - meta_scope: comment.block.mucad
        - match: \*/
          scope: punctuation.definition.comment.end.mucad
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.mucad
      push:
        - meta_scope: string.quoted.double.mucad
        - match: \\.
          scope: constant.character.escape.mucad
        - match: '"'
          scope: punctuation.definition.string.end.mucad
          pop: true

  keywords:
    - match: \b(use|mod|pub|const|let|fn|part|sketch|op|prop|init|if|else|for|in|return)\b
      scope: keyword.control.mucad
    - match: \b(true|false)\b
      scope: constant.language.boolean.mucad
    - match: '@[a-zA-Z_][a-zA-Z0-9_]*'
      scope: variable.language.special.mucad

  types:
    - match: \b(Integer|Scalar|Angle|Length|Area|Volume|String|Bool|Vec2|Vec3|Vec4|Mat2|Mat3|Mat4|Color)\b
      scope: storage.type.mucad

  numbers_and_units:
    - match: \b[0-9]+(\.[0-9]+)?(mm|cm|m|in|ft|deg|rad)?\b
      scope: constant.numeric.mucad

  functions_and_workbenches:
    - match: \b(part|sketch|op|fn)\s+([a-zA-Z_][a-zA-Z0-9_]*)
      captures:
        1: keyword.declaration.mucad
        2: entity.name.function.mucad
    - match: \b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()
      scope: variable.function.mucad

  operators:
    - match: (\+|\-|\*|/|%|\||&|~|=|==|!=|<|>|<=|>=|\.\.|::|\->)
      scope: keyword.operator.mucad

  punctuation:
    - match: '[\{\}\(\)\[\];:,.]'
      scope: punctuation.separator.mucad
